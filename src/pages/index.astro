---
import Layout from "../layouts/Layout.astro";
import LucideIcons from "../components/LucideIcons.astro";
import Header from "../components/Header.astro";
import BackToTop from "../components/BackToTop.astro";
---

<Layout>
    <Header />
    <LucideIcons>
        <a href="#main-content" class="skip-to-content">Skip to main content</a>

        <main id="main-content">
            <!-- Hero -->
            <section class="max-w-7xl mx-auto px-6 pt-32 pb-20 md:pt-40 md:pb-28">
                <div class="max-w-3xl">
                    <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-6">
                        Senior Software Engineer · 11+ yrs
                    </div>
                    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tighter text-gray-100 leading-[1.05]">
                        I design and build<br />production systems.
                    </h1>
                    <p class="mt-8 text-lg md:text-xl text-gray-400 leading-relaxed max-w-2xl">
                        Frameworks, protocol implementations, and replication tools.
                        Go, TypeScript, SQLite. I measure everything and ship what I'd use myself.
                    </p>
                    <div class="mt-10 flex flex-wrap items-center gap-4">
                        <a
                            href="https://github.com/maulanashalihin"
                            class="inline-flex items-center gap-2 text-gray-300 hover:text-cyan-400 transition font-mono text-sm"
                        >
                            <i data-lucide="github" class="w-5 h-5"></i>
                            github.com/maulanashalihin
                        </a>
                        <span class="text-gray-700">·</span>
                        <a
                            href="https://www.linkedin.com/in/maulana-shalihin"
                            class="inline-flex items-center gap-2 text-gray-300 hover:text-cyan-400 transition font-mono text-sm"
                        >
                            <i data-lucide="linkedin" class="w-5 h-5"></i>
                            LinkedIn
                        </a>
                        <span class="text-gray-700">·</span>
                        <a
                            href="mailto:maulana@drip.id"
                            class="inline-flex items-center gap-2 text-gray-300 hover:text-cyan-400 transition font-mono text-sm"
                        >
                            <i data-lucide="mail" class="w-5 h-5"></i>
                            maulana@drip.id
                        </a>
                    </div>
                </div>
            </section>

            <!-- Selected Work -->
            <section id="work" class="max-w-7xl mx-auto px-6 py-20 border-t border-[#2A2F3A]">
                <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-3">
                    Selected Work
                </div>
                <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-gray-100 mb-12">
                    Things I've built.
                </h2>

                <div class="space-y-6">
                    <!-- walsync -->
                    <a
                        href="https://github.com/maulanashalihin/walsync"
                        class="block bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                    >
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                            <div>
                                <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">
                                    walsync
                                </h3>
                                <p class="mt-2 text-gray-400 max-w-2xl">
                                    Live SQLite WAL shipping replication. Go binary with HTTP/Fiber transport
                                    and gzip compression. Ships WAL frames to replicas in real-time.
                                </p>
                            </div>
                            <div class="flex gap-6 font-mono text-sm shrink-0">
                                <div>
                                    <div class="text-cyan-400 font-bold">348K</div>
                                    <div class="text-gray-600 text-xs">read QPS</div>
                                </div>
                                <div>
                                    <div class="text-cyan-400 font-bold">84K</div>
                                    <div class="text-gray-600 text-xs">write QPS</div>
                                </div>
                                <div>
                                    <div class="text-cyan-400 font-bold">Go</div>
                                    <div class="text-gray-600 text-xs">binary</div>
                                </div>
                            </div>
                        </div>
                    </a>

                    <!-- learn-api -->
                    <a
                        href="https://github.com/maulanashalihin/learn-api"
                        class="block bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                    >
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                            <div>
                                <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">
                                    learn-api
                                </h3>
                                <p class="mt-2 text-gray-400 max-w-2xl">
                                    Hands-on API technologies course: 19 modules from REST to CRDT multi-writer
                                    replication. Node.js + TypeScript + Bun. Each module is working code + README.
                                </p>
                            </div>
                            <div class="flex gap-6 font-mono text-sm shrink-0">
                                <div>
                                    <div class="text-cyan-400 font-bold">19</div>
                                    <div class="text-gray-600 text-xs">modules</div>
                                </div>
                                <div>
                                    <div class="text-cyan-400 font-bold">TS</div>
                                    <div class="text-gray-600 text-xs">+ Bun</div>
                                </div>
                            </div>
                        </div>
                    </a>

                    <!-- laju -->
                    <a
                        href="https://github.com/maulanashalihin/laju"
                        class="block bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                    >
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                            <div>
                                <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">
                                    laju
                                </h3>
                                <p class="mt-2 text-gray-400 max-w-2xl">
                                    High-performance TypeScript web framework. HyperExpress + Svelte 5 + Inertia.js
                                    with dev server, codegen, and SQLite ORM. 23 stars on GitHub.
                                </p>
                            </div>
                            <div class="flex gap-6 font-mono text-sm shrink-0">
                                <div>
                                    <div class="text-cyan-400 font-bold">258K</div>
                                    <div class="text-gray-600 text-xs">RPS</div>
                                </div>
                                <div>
                                    <div class="text-cyan-400 font-bold">23★</div>
                                    <div class="text-gray-600 text-xs">GitHub</div>
                                </div>
                            </div>
                        </div>
                    </a>

                    <!-- Protocol libraries -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <a
                            href="https://github.com/maulanashalihin/fiber-inertia"
                            class="block bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                        >
                            <h3 class="text-lg font-bold text-gray-100 group-hover:text-cyan-400 transition">
                                fiber-inertia
                            </h3>
                            <p class="mt-2 text-gray-400 text-sm">
                                Inertia.js v3 server-side adapter for Go Fiber. Auto-detect JSON/HTML,
                                asset versioning, partial reloads. Native — no bridge.
                            </p>
                            <div class="mt-4 font-mono text-xs text-gray-600">Go · MIT · CI</div>
                        </a>
                        <a
                            href="https://github.com/maulanashalihin/tusdfiber"
                            class="block bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                        >
                            <h3 class="text-lg font-bold text-gray-100 group-hover:text-cyan-400 transition">
                                tusdfiber
                            </h3>
                            <p class="mt-2 text-gray-400 text-sm">
                                Native TUS resumable upload protocol for Go Fiber. Streaming body,
                                Prometheus metrics. First-class Fiber handler — no adaptor.
                            </p>
                            <div class="mt-4 font-mono text-xs text-gray-600">Go · MIT · CI</div>
                        </a>
                    </div>
                </div>
            </section>

            <!-- Engineering Notes -->
            <section id="engineering" class="bg-[#0F131A] py-20 border-t border-[#2A2F3A]">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-3">
                        Engineering Notes
                    </div>
                    <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-gray-100 mb-12">
                        Research I've done.
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        <div class="bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-6">
                            <div class="text-cyan-400 font-mono text-xs mb-3">BENCHMARK</div>
                            <h3 class="text-lg font-bold text-gray-100 mb-2">
                                SQLite Replication Landscape
                            </h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Tested walsync, LiteFS, Marmot, cr-sqlite, HarmonyLite, and HA SQLite
                                on OVH VPS. Measured read/write QPS, replication latency, and conflict
                                resolution. walsync: 348K read, 84K write QPS.
                            </p>
                        </div>

                        <div class="bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-6">
                            <div class="text-cyan-400 font-mono text-xs mb-3">BENCHMARK</div>
                            <h3 class="text-lg font-bold text-gray-100 mb-2">
                                HTTP/3 vs HTTP/1.1
                            </h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Cross-server test: OVH Singapore ↔ Underconst Bandung. Bun 1.4 HTTP/3
                                experimental lacks connection pooling — TLS handshake overhead 4-5x.
                                HTTP/1.1 + 50ms interval = 319ms batch propagation. HTTP/3 not worth
                                it for server-to-server sync.
                            </p>
                        </div>

                        <div class="bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-6">
                            <div class="text-cyan-400 font-mono text-xs mb-3">BENCHMARK</div>
                            <h3 class="text-lg font-bold text-gray-100 mb-2">
                                Framework Performance
                            </h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                HyperExpress (uWebSockets) vs Express vs Bun.serve. laju framework
                                hits 258K RPS on a single VPS. Express still dominant for API-to-API
                                at 50%+ market share, but not for raw throughput.
                            </p>
                        </div>

                        <div class="bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-6">
                            <div class="text-cyan-400 font-mono text-xs mb-3">RESEARCH</div>
                            <h3 class="text-lg font-bold text-gray-100 mb-2">
                                CRDT Multi-Writer Replication
                            </h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Built cr-sqlite module: CRDT-based multi-writer SQLite replication using
                                Bun + crsqlite extension. Cross-server convergence verified. 4.2x write
                                overhead, zero read overhead vs plain SQLite.
                            </p>
                        </div>

                        <div class="bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-6">
                            <div class="text-cyan-400 font-mono text-xs mb-3">BENCHMARK</div>
                            <h3 class="text-lg font-bold text-gray-100 mb-2">
                                PostgreSQL 18
                            </h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                Benchmarked PostgreSQL 18 against SQLite for read-heavy workloads.
                                Tested connection pooling, WAL configuration, and async replication.
                                Documented when to use each.
                            </p>
                        </div>

                        <div class="bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-6">
                            <div class="text-cyan-400 font-mono text-xs mb-3">COURSE</div>
                            <h3 class="text-lg font-bold text-gray-100 mb-2">
                                19 API Technologies
                            </h3>
                            <p class="text-gray-400 text-sm leading-relaxed">
                                REST, GraphQL, gRPC, tRPC, WebSockets, SSE, Webhooks, Kafka, Raft,
                                Redis Pub/Sub, BullMQ, JWT, OAuth2, rate limiting, circuit breakers,
                                WAL shipping, CRDT replication, HTTP/2, HTTP/3. Each with working code.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Stack -->
            <section id="stack" class="max-w-7xl mx-auto px-6 py-20 border-t border-[#2A2F3A]">
                <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-3">
                    Stack
                </div>
                <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-gray-100 mb-12">
                    What I use.
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div>
                        <div class="text-gray-600 font-mono text-xs uppercase mb-3">Frontend</div>
                        <ul class="space-y-2 text-gray-300">
                            <li>Svelte 5</li>
                            <li>React Router v7</li>
                            <li>Inertia.js v3</li>
                            <li>Tailwind CSS v4</li>
                        </ul>
                    </div>
                    <div>
                        <div class="text-gray-600 font-mono text-xs uppercase mb-3">Backend</div>
                        <ul class="space-y-2 text-gray-300">
                            <li>Go · Fiber</li>
                            <li>HyperExpress · Node.js</li>
                            <li>Bun · Hono</li>
                            <li>TUS resumable uploads</li>
                        </ul>
                    </div>
                    <div>
                        <div class="text-gray-600 font-mono text-xs uppercase mb-3">Database</div>
                        <ul class="space-y-2 text-gray-300">
                            <li>SQLite · WAL mode</li>
                            <li>PostgreSQL 18</li>
                            <li>Cloudflare D1</li>
                            <li>BadgerDB</li>
                        </ul>
                    </div>
                    <div>
                        <div class="text-gray-600 font-mono text-xs uppercase mb-3">Infra</div>
                        <ul class="space-y-2 text-gray-300">
                            <li>VPS · Cloudflare</li>
                            <li>Docker</li>
                            <li>Stripe</li>
                            <li>GitHub Actions CI</li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- About -->
            <section id="about" class="bg-[#0F131A] py-20 border-t border-[#2A2F3A]">
                <div class="max-w-3xl mx-auto px-6">
                    <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-3">
                        About
                    </div>
                    <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-gray-100 mb-8">
                        Engineer, not agency.
                    </h2>
                    <div class="space-y-6 text-gray-400 leading-relaxed text-lg">
                        <p>
                            11+ years building software. I started with PHP, moved to Node.js, then Go,
                            and now work across all three. My focus is infrastructure: frameworks,
                            protocol implementations, replication tools, and production boilerplates.
                        </p>
                        <p>
                            I don't do agencies, project managers, or status meetings. I write code,
                            measure it, and ship it. Every repo on my GitHub has CI, MIT licensing,
                            and professional documentation — because that's the baseline, not the feature.
                        </p>
                        <p>
                            I've built 20+ projects including queue management systems handling thousands
                            of users daily, web frameworks hitting 258K RPS, and SQLite replication tools
                            matching native embedded performance. I measure everything.
                        </p>
                    </div>

                    <div class="mt-12 grid grid-cols-3 gap-6">
                        <div>
                            <div class="text-3xl font-bold text-cyan-400 font-mono">11+</div>
                            <div class="text-gray-600 text-sm mt-1">years experience</div>
                        </div>
                        <div>
                            <div class="text-3xl font-bold text-cyan-400 font-mono">55+</div>
                            <div class="text-gray-600 text-sm mt-1">public repos</div>
                        </div>
                        <div>
                            <div class="text-3xl font-bold text-cyan-400 font-mono">258K</div>
                            <div class="text-gray-600 text-sm mt-1">RPS benchmarked</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Contact -->
            <section id="contact" class="max-w-3xl mx-auto px-6 py-24 text-center border-t border-[#2A2F3A]">
                <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-3">
                    Contact
                </div>
                <h2 class="text-3xl md:text-5xl font-bold tracking-tighter text-gray-100 mb-6">
                    Let's talk.
                </h2>
                <p class="text-gray-400 text-lg mb-10 max-w-xl mx-auto">
                    Email is the fastest way to reach me. I respond within 24 hours.
                </p>
                <a
                    href="mailto:maulana@drip.id"
                    class="inline-flex items-center gap-3 bg-cyan-500 text-[#0A0D12] font-bold px-8 py-4 rounded-xl hover:bg-cyan-400 transition text-lg"
                >
                    <i data-lucide="mail" class="w-5 h-5"></i>
                    maulana@drip.id
                </a>
            </section>

            <!-- Footer -->
            <footer class="border-t border-[#2A2F3A] py-12">
                <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
                    <div class="text-gray-600 font-mono text-sm">
                        Maulana Shalihin · Senior Software Engineer
                    </div>
                    <div class="flex items-center gap-6">
                        <a
                            href="https://github.com/maulanashalihin"
                            class="text-gray-500 hover:text-cyan-400 transition"
                        >
                            <i data-lucide="github" class="w-5 h-5"></i>
                        </a>
                        <a
                            href="https://www.linkedin.com/in/maulana-shalihin"
                            class="text-gray-500 hover:text-cyan-400 transition"
                        >
                            <i data-lucide="linkedin" class="w-5 h-5"></i>
                        </a>
                        <a
                            href="mailto:maulana@drip.id"
                            class="text-gray-500 hover:text-cyan-400 transition"
                        >
                            <i data-lucide="mail" class="w-5 h-5"></i>
                        </a>
                    </div>
                </div>
            </footer>
        </main>

        <BackToTop />
    </LucideIcons>
</Layout>
