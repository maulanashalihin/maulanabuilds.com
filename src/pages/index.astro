---
import Layout from "../layouts/Layout.astro";
import LucideIcons from "../components/LucideIcons.astro";
import Header from "../components/Header.astro";
import BackToTop from "../components/BackToTop.astro";
---

<Layout>
    <Header />
    <LucideIcons>
        <a href="#main-content" class="skip-to-content">Skip to main content</a>

        <main id="main-content">
            <!-- Hero -->
            <section class="max-w-7xl mx-auto px-6 pt-32 pb-20 md:pt-40 md:pb-28">
                <div class="max-w-3xl">
                    <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-6">
                        Senior Software Engineer · 11+ yrs
                    </div>
                    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tighter leading-[1.05]">
                        <span class="text-gray-100">I design and build</span><br />
                        <span class="bg-gradient-to-r from-cyan-400 to-cyan-600 bg-clip-text text-transparent">production systems.</span>
                    </h1>
                    <p class="mt-8 text-lg md:text-xl text-gray-400 leading-relaxed max-w-2xl">
                        Frameworks, protocol implementations, and replication tools.
                        Go, TypeScript, SQLite. I measure everything and ship what I'd use myself.
                    </p>
                    <div class="mt-10 flex flex-wrap items-center gap-4">
                        <a
                            href="https://github.com/maulanashalihin"
                            class="inline-flex items-center gap-2 text-gray-300 hover:text-cyan-400 transition font-mono text-sm"
                        >
                            <i data-lucide="github" class="w-5 h-5"></i>
                            github.com/maulanashalihin
                        </a>
                        <span class="text-gray-700">·</span>
                        <a
                            href="https://www.linkedin.com/in/maulana-shalihin"
                            class="inline-flex items-center gap-2 text-gray-300 hover:text-cyan-400 transition font-mono text-sm"
                        >
                            <i data-lucide="linkedin" class="w-5 h-5"></i>
                            LinkedIn
                        </a>
                        <span class="text-gray-700">·</span>
                        <a
                            href="mailto:maulana@drip.id"
                            class="inline-flex items-center gap-2 text-gray-300 hover:text-cyan-400 transition font-mono text-sm"
                        >
                            <i data-lucide="mail" class="w-5 h-5"></i>
                            maulana@drip.id
                        </a>
                    </div>

                    <!-- Metrics -->
                    <div class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-px bg-[#2A2F3A] border border-[#2A2F3A] rounded-2xl overflow-hidden">
                        <div class="bg-[#0A0D12] p-6">
                            <div class="text-3xl font-bold text-cyan-400 font-mono">11+</div>
                            <div class="text-gray-600 text-sm mt-1">years</div>
                        </div>
                        <div class="bg-[#0A0D12] p-6">
                            <div class="text-3xl font-bold text-cyan-400 font-mono">12K+</div>
                            <div class="text-gray-600 text-sm mt-1">users served</div>
                        </div>
                        <div class="bg-[#0A0D12] p-6">
                            <div class="text-3xl font-bold text-cyan-400 font-mono">10K</div>
                            <div class="text-gray-600 text-sm mt-1">live viewers</div>
                        </div>
                        <div class="bg-[#0A0D12] p-6">
                            <div class="text-3xl font-bold text-cyan-400 font-mono">258K</div>
                            <div class="text-gray-600 text-sm mt-1">RPS benchmarked</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Production Systems -->
            <section id="work" class="max-w-7xl mx-auto px-6 py-20 border-t border-[#2A2F3A]">
                <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-3">
                    Production Systems
                </div>
                <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-gray-100 mb-4">
                    Real products, real users.
                </h2>
                <p class="text-gray-500 mb-12 max-w-2xl">
                    SaaS products and infrastructure I built and shipped — not demos, not tutorials.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- dripsender -->
                    <div class="bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8">
                        <h3 class="text-xl font-bold text-gray-100">dripsender.id</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">
                            WhatsApp marketing automation serving 12,000+ users across 14 servers.
                        </p>
                        <div class="mt-4 flex gap-6 font-mono text-sm">
                            <div><span class="text-cyan-400 font-bold">12K+</span> <span class="text-gray-600 text-xs">users</span></div>
                            <div><span class="text-cyan-400 font-bold">14</span> <span class="text-gray-600 text-xs">servers</span></div>
                        </div>
                    </div>

                    <!-- Antre.in -->
                    <div class="bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8">
                        <h3 class="text-xl font-bold text-gray-100">Antre.in</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">
                            Healthcare B2B SaaS. Real-time patient queue management, multi-tenant, RBAC.
                        </p>
                        <div class="mt-4 flex gap-6 font-mono text-sm">
                            <div><span class="text-cyan-400 font-bold">B2B</span> <span class="text-gray-600 text-xs">healthcare</span></div>
                        </div>
                    </div>

                    <!-- Orderlink -->
                    <div class="bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8">
                        <h3 class="text-xl font-bold text-gray-100">Orderlink.in</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">
                            SaaS platform with 2,000+ paid subscribers. Subscription billing, multi-tenant.
                        </p>
                        <div class="mt-4 flex gap-6 font-mono text-sm">
                            <div><span class="text-cyan-400 font-bold">2K+</span> <span class="text-gray-600 text-xs">paid subs</span></div>
                        </div>
                    </div>

                    <!-- EatJom -->
                    <div class="bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8">
                        <h3 class="text-xl font-bold text-gray-100">EatJom</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">
                            Multi-tenant restaurant SaaS. QR ordering, multi-kitchen receipts, custom branding.
                        </p>
                        <div class="mt-4 flex gap-6 font-mono text-sm">
                            <div><span class="text-cyan-400 font-bold">SaaS</span> <span class="text-gray-600 text-xs">multi-tenant</span></div>
                        </div>
                    </div>

                    <!-- slug-post -->
                    <a
                        href="https://slugpost.com"
                        class="block bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                    >
                        <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">
                            slug-post
                            <i data-lucide="external-link" class="inline w-4 h-4 ml-1 text-gray-600"></i>
                        </h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">
                            Markdown to shareable web page. No registration. Live at slugpost.com.
                        </p>
                        <div class="mt-4 flex gap-6 font-mono text-sm">
                            <div><span class="text-cyan-400 font-bold">8★</span> <span class="text-gray-600 text-xs">GitHub</span></div>
                            <div><span class="text-cyan-400 font-bold">live</span> <span class="text-gray-600 text-xs">slugpost.com</span></div>
                        </div>
                    </a>

                    <!-- klikaja -->
                    <a
                        href="https://klikaja.app"
                        class="block bg-[#0F131A] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                    >
                        <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">
                            KlikAja
                            <i data-lucide="external-link" class="inline w-4 h-4 ml-1 text-gray-600"></i>
                        </h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">
                            Smart link shortener with analytics. QR codes, A/B testing, geo-routing.
                        </p>
                        <div class="mt-4 flex gap-6 font-mono text-sm">
                            <div><span class="text-cyan-400 font-bold">3★</span> <span class="text-gray-600 text-xs">GitHub</span></div>
                            <div><span class="text-cyan-400 font-bold">live</span> <span class="text-gray-600 text-xs">klikaja.app</span></div>
                        </div>
                    </a>

                    <!-- Live Streaming — full width, special treatment -->
                    <div class="bg-[#0F131A] border border-cyan-500/20 rounded-2xl p-8 md:col-span-2 relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-64 h-64 bg-cyan-500/5 rounded-full blur-3xl"></div>
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 relative">
                            <div>
                                <h3 class="text-xl font-bold text-gray-100">Live Streaming Platform</h3>
                                <p class="mt-2 text-gray-400 text-sm leading-relaxed max-w-2xl">
                                    10,000 concurrent viewers. Zero buffering. A fraction of typical CDN costs.
                                    First event ran flawlessly — auto-adaptive quality, global edge delivery.
                                </p>
                            </div>
                            <div class="flex gap-6 font-mono text-sm shrink-0">
                                <div><div class="text-cyan-400 font-bold">10K</div><div class="text-gray-600 text-xs">concurrent</div></div>
                                <div><div class="text-cyan-400 font-bold">0</div><div class="text-gray-600 text-xs">buffering</div></div>
                                <div><div class="text-cyan-400 font-bold">low</div><div class="text-gray-600 text-xs">cost</div></div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Open Source -->
            <section id="opensource" class="bg-[#0F131A] py-20 border-t border-[#2A2F3A]">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-3">
                        Open Source
                    </div>
                    <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-gray-100 mb-4">
                        Libraries, frameworks, and tools.
                    </h2>
                    <p class="text-gray-500 mb-12 max-w-2xl">
                        55+ public repos. All MIT, all with CI.
                    </p>

                    <!-- Featured -->
                    <div class="space-y-6 mb-8">
                        <a
                            href="https://github.com/maulanashalihin/walsync"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                        >
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                <div>
                                    <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">walsync</h3>
                                    <p class="mt-2 text-gray-400">SQLite WAL shipping replication. Go binary, HTTP transport, gzip.</p>
                                </div>
                                <div class="flex gap-6 font-mono text-sm shrink-0">
                                    <div><div class="text-cyan-400 font-bold">348K</div><div class="text-gray-600 text-xs">read QPS</div></div>
                                    <div><div class="text-cyan-400 font-bold">84K</div><div class="text-gray-600 text-xs">write QPS</div></div>
                                </div>
                            </div>
                        </a>

                        <a
                            href="https://github.com/maulanashalihin/laju"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                        >
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                <div>
                                    <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">laju</h3>
                                    <p class="mt-2 text-gray-400">High-performance TypeScript web framework. Powers slugpost.com and klikaja.app.</p>
                                </div>
                                <div class="flex gap-6 font-mono text-sm shrink-0">
                                    <div><div class="text-cyan-400 font-bold">258K</div><div class="text-gray-600 text-xs">RPS</div></div>
                                    <div><div class="text-cyan-400 font-bold">23★</div><div class="text-gray-600 text-xs">GitHub</div></div>
                                </div>
                            </div>
                        </a>

                        <a
                            href="https://github.com/maulanashalihin/dulak"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                        >
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                <div>
                                    <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">dulak</h3>
                                    <p class="mt-2 text-gray-400">Full-stack Bun boilerplate. Auth, uploads, SSR, 6 templates. <span class="text-cyan-600">npm create-dulak</span>.</p>
                                </div>
                                <div class="flex gap-6 font-mono text-sm shrink-0">
                                    <div><div class="text-cyan-400 font-bold">6★</div><div class="text-gray-600 text-xs">GitHub</div></div>
                                    <div><div class="text-cyan-400 font-bold">Bun</div><div class="text-gray-600 text-xs">runtime</div></div>
                                </div>
                            </div>
                        </a>

                        <a
                            href="https://github.com/maulanashalihin/kilat"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                        >
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                <div>
                                    <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">kilat</h3>
                                    <p class="mt-2 text-gray-400">Cloudflare Workers edge starter. Deploys to 300+ locations. Zero ops.</p>
                                </div>
                                <div class="flex gap-6 font-mono text-sm shrink-0">
                                    <div><div class="text-cyan-400 font-bold">6★</div><div class="text-gray-600 text-xs">GitHub</div></div>
                                    <div><div class="text-cyan-400 font-bold">300+</div><div class="text-gray-600 text-xs">edge locs</div></div>
                                </div>
                            </div>
                        </a>

                        <a
                            href="https://github.com/maulanashalihin/learn-api"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-2xl p-8 hover:border-cyan-500/50 transition group"
                        >
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                <div>
                                    <h3 class="text-xl font-bold text-gray-100 group-hover:text-cyan-400 transition">learn-api</h3>
                                    <p class="mt-2 text-gray-400">19-module API technologies course. REST to CRDT replication. Working code + README.</p>
                                </div>
                                <div class="flex gap-6 font-mono text-sm shrink-0">
                                    <div><div class="text-cyan-400 font-bold">19</div><div class="text-gray-600 text-xs">modules</div></div>
                                </div>
                            </div>
                        </a>
                    </div>

                    <!-- Compact grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        <a
                            href="https://github.com/maulanashalihin/laju-go"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group"
                        >
                            <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">laju-go</h3>
                            <p class="mt-1 text-gray-500 text-sm">Go Fiber SaaS boilerplate. <span class="text-cyan-600">npx create-laju-go</span></p>
                        </a>
                        <a
                            href="https://github.com/maulanashalihin/fiber-inertia"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group"
                        >
                            <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">fiber-inertia</h3>
                            <p class="mt-1 text-gray-500 text-sm">Inertia.js v3 adapter for Go Fiber.</p>
                        </a>
                        <a
                            href="https://github.com/maulanashalihin/tusdfiber"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group"
                        >
                            <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">tusdfiber</h3>
                            <p class="mt-1 text-gray-500 text-sm">TUS resumable uploads for Go Fiber.</p>
                        </a>
                        <a
                            href="https://github.com/maulanashalihin/svelte-wysiwyg-editor"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group"
                        >
                            <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">svelte-wysiwyg-editor</h3>
                            <p class="mt-1 text-gray-500 text-sm">WYSIWYG editor for Svelte 4 & 5. npm package.</p>
                        </a>
                        <a
                            href="https://github.com/maulanashalihin/cdn-s3-proxy"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group"
                        >
                            <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">cdn-s3-proxy</h3>
                            <p class="mt-1 text-gray-500 text-sm">S3 CDN reverse proxy with disk caching. Go.</p>
                        </a>
                        <a
                            href="https://github.com/maulanashalihin/go-sqlite-benchmark-mattn-vs-modernc"
                            class="block bg-[#0A0D12] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group"
                        >
                            <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">go-sqlite-benchmark</h3>
                            <p class="mt-1 text-gray-500 text-sm">mattn vs modernc SQLite driver benchmark.</p>
                        </a>
                    </div>
                </div>
            </section>

            <!-- Engineering Notes -->
            <section id="engineering" class="max-w-7xl mx-auto px-6 py-20 border-t border-[#2A2F3A]">
                <div class="text-cyan-400 text-sm font-mono tracking-widest uppercase mb-3">
                    Engineering Notes
                </div>
                <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-gray-100 mb-4">
                    Opinions, backed by benchmarks.
                </h2>
                <p class="text-gray-500 mb-12 max-w-2xl">
                    14 engineering notes on architecture, databases, auth, and deployment.
                    Written for the dulak boilerplate docs.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <a href="https://dulak.pages.dev/blog/why-no-nginx/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">Nginx is dead. Cloudflare killed it.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-sqlite-not-postgres/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">SQLite beats Postgres — we benchmarked it.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-no-orm/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">ORMs are dead in 2026. AI killed them.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-sessions-not-jwt/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">JWT is the wrong default. Sessions are the right one.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-argon2id-not-bcrypt/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">bcrypt is from 1999. Your passwords deserve better.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-leave-nextjs/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">Next.js is the default. It should not be.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-leave-laravel/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">Laravel is good. Your next project should not use it.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-bun-not-node/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">Node needs 5 tools. Bun ships one.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/ssr-vs-spa/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">SSR vs SPA: 50ms to content, or 2 seconds of blank screen.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-inertia-not-spa/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">Your SPA needs a router, an API, and state. Inertia needs none of it.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-no-cache-service/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">Your database is already the cache.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/why-vanilla-css-not-tailwind/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">Tailwind is a build step you don't need.</h3>
                    </a>
                    <a href="https://dulak.pages.dev/blog/how-to-upload-files-over-100mb/" class="block bg-[#0F131A] border border-[#2A2F3A] rounded-xl p-5 hover:border-cyan-500/50 transition group">
                        <h3 class="text-base font-bold text-gray-100 group-hover:text-cyan-400 transition">Your 2GB upload keeps failing. Here's the fix.</h3>
                    </a>
