---
import Layout from "../layouts/Layout.astro";
import LucideIcons from "../components/LucideIcons.astro";
import Header from "../components/Header.astro";
import BackToTop from "../components/BackToTop.astro";
---

<Layout>
    <Header />
    <LucideIcons>
        <a href="#main-content" class="skip-to-content">Skip to main content</a>

        <style>
            /* ---------- signature motion system (page-scoped) ---------- */
            .font-display { letter-spacing: -0.045em; }
            .text-glow { text-shadow: 0 0 42px rgba(34, 211, 238, 0.35); }
            .outline-text {
                color: transparent;
                -webkit-text-stroke: 1px rgba(148, 163, 184, 0.35);
            }
            /* reveal on scroll */
            .rv { opacity: 0; transform: translateY(30px); transition: opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1); }
            .rv.in { opacity: 1; transform: none; }
            .rv-d1 { transition-delay: .08s; } .rv-d2 { transition-delay: .16s; }
            .rv-d3 { transition-delay: .24s; } .rv-d4 { transition-delay: .32s; }
            /* marquee */
            @keyframes mq { to { transform: translateX(-50%); } }
            .mq-track { display: flex; width: max-content; animation: mq 30s linear infinite; }
            .mq-track:hover { animation-play-state: paused; }
            /* blinking caret */
            @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
            .caret { animation: blink 1.05s step-end infinite; }
            /* live dot */
            @keyframes ping2 { 0% { box-shadow: 0 0 0 0 rgba(52, 211, 153, .6); } 70% { box-shadow: 0 0 0 9px rgba(52, 211, 153, 0); } 100% { box-shadow: 0 0 0 0 rgba(52, 211, 153, 0); } }
            .live-dot { animation: ping2 1.8s ease-out infinite; }
            /* benchmark bars */
            .bar { transform: scaleX(0); transform-origin: left; transition: transform 1.4s cubic-bezier(.2,.8,.2,1); }
            .in .bar { transform: scaleX(1); }
            /* spotlight cards */
            .spot { position: relative; }
            .spot::before {
                content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
                background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(34,211,238,.09), transparent 65%);
                opacity: 0; transition: opacity .35s;
            }
            .spot:hover::before { opacity: 1; }
            /* editorial list rows */
            .note-row { transition: padding .3s, background .3s, border-color .3s; }
            .note-row:hover { padding-left: 1.75rem; background: rgba(34,211,238,.04); }
            .note-row:hover .note-title { color: #22d3ee; }
            /* magnetic cta */
            .magnetic { transition: transform .25s cubic-bezier(.2,.7,.2,1), box-shadow .3s, background .3s; will-change: transform; }
            .magnetic:hover { box-shadow: 0 0 0 6px rgba(34,211,238,.14), 0 24px 70px -18px rgba(34,211,238,.55); }
            /* hero float */
            @keyframes floaty { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
            /* grid pulse behind hero canvas */
            #field { position: absolute; inset: 0; width: 100%; height: 100%; }
            @media (prefers-reduced-motion: reduce) {
                .rv { opacity: 1; transform: none; }
                .mq-track, .caret, .live-dot { animation: none; }
                .bar { transform: none; }
            }
        </style>

        <main id="main-content">
            <!-- ============ HERO ============ -->
            <section class="relative min-h-svh flex flex-col overflow-hidden">
                <canvas id="field" aria-hidden="true"></canvas>
                <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
                    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[720px] h-[420px] bg-cyan-500/10 rounded-full blur-[130px]"></div>
                    <div class="absolute bottom-0 right-0 w-[420px] h-[300px] bg-emerald-500/[.07] rounded-full blur-[110px]"></div>
                </div>
                <div class="hero-grid absolute inset-0 pointer-events-none" aria-hidden="true"></div>

                <div class="relative flex-1 flex flex-col justify-center max-w-7xl mx-auto px-6 w-full pt-32 pb-16">
                    <!-- status HUD -->
                    <div class="rv flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-xs md:text-sm text-gray-500 mb-8">
                        <span class="inline-flex items-center gap-2 text-emerald-400">
                            <span class="live-dot w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
                            available for 1 project
                        </span>
                        <span class="hidden sm:inline text-gray-700">|</span>
                        <span>jakarta <span id="clock" class="text-gray-300">--:--:--</span> wib</span>
                    </div>

                    <p class="rv rv-d1 font-mono text-cyan-400 text-sm tracking-[.3em] uppercase mb-6">
                        $ whoami — senior software engineer · 11+ yrs
                    </p>
                    <h1 class="rv rv-d2 font-display font-bold text-gray-100 text-[clamp(2.6rem,7.5vw,5.8rem)] leading-[1.02]">
                        I build systems<br />
                        that survive<br />
                        <span class="bg-gradient-to-r from-cyan-300 via-cyan-400 to-emerald-400 bg-clip-text text-transparent text-glow">production.</span>
                    </h1>
                    <p class="rv rv-d3 mt-7 text-lg md:text-xl text-gray-400 leading-relaxed max-w-2xl">
                        <span class="text-gray-200">Backend in Go, mobile in Flutter and Kotlin.</span>
                        SQLite by default, Postgres tuned when you need it — all running in production somewhere.
                    </p>
                    <p class="rv rv-d3 mt-4 font-mono text-sm text-gray-500">
                        <span class="text-cyan-500">❯</span> <span id="typer"></span><span class="caret text-cyan-400">▊</span>
                    </p>

                    <div class="rv rv-d4 mt-10 flex flex-wrap items-center gap-4">
                        <a href="#offer" class="magnetic magnetic-btn inline-flex items-center gap-2 bg-cyan-400 text-[#0A0D12] font-bold px-7 py-3.5 rounded-xl hover:bg-cyan-300">
                            <i data-lucide="rocket" class="w-5 h-5"></i>
                            Start your build
                        </a>
                        <a href="#work" class="magnetic magnetic-btn inline-flex items-center gap-2 border border-[#2A2F3A] text-gray-200 px-7 py-3.5 rounded-xl hover:border-cyan-500/60 hover:text-cyan-300 bg-white/[.02]">
                            See the proof
                            <i data-lucide="arrow-down" class="w-4 h-4"></i>
                        </a>
                        <a href="https://github.com/maulanashalihin" class="inline-flex items-center gap-2 text-gray-400 hover:text-cyan-400 transition font-mono text-sm ml-1">
                            <i data-lucide="github" class="w-5 h-5"></i>
                            <span class="hidden sm:inline">github.com/maulanashalihin</span><span class="sm:hidden">GitHub</span>
                        </a>
                    </div>

                    <!-- metrics -->
                    <div class="rv rv-d4 mt-14 grid grid-cols-2 md:grid-cols-3 gap-px bg-[#2A2F3A] border border-[#2A2F3A] rounded-2xl overflow-hidden max-w-4xl">
                        <div class="bg-[#0A0D12]/95 p-6">
                            <div class="text-3xl md:text-4xl font-bold text-cyan-400"><span data-count="11">0</span>+</div>
                            <div class="text-gray-600 text-sm mt-1">years shipping</div>
                        </div>
                        <div class="bg-[#0A0D12]/95 p-6">
                            <div class="text-3xl md:text-4xl font-bold text-cyan-400"><span data-count="12">0</span>K+</div>
                            <div class="text-gray-600 text-sm mt-1">users on dripsender</div>
                        </div>
                        <div class="bg-[#0A0D12]/95 p-6">
                            <div class="text-3xl md:text-4xl font-bold text-cyan-400"><span data-count="72">0</span>K+</div>
                            <div class="text-gray-600 text-sm mt-1">visitors, one live event</div>
                        </div>
                    </div>
                </div>

                <div class="relative pb-8 flex justify-center">
                    <a href="#stack" aria-label="Scroll down" class="text-gray-600 hover:text-cyan-400 transition" style="animation: floaty 2.4s ease-in-out infinite">
                        <i data-lucide="chevron-down" class="w-6 h-6"></i>
                    </a>
                </div>
            </section>

            <!-- ============ STACK TICKER ============ -->
            <div id="stack" class="border-y border-[#2A2F3A] bg-[#0C0F15] overflow-hidden py-4 select-none" aria-hidden="true">
                <div class="mq-track font-mono text-sm tracking-[.25em] text-gray-600 uppercase" id="mq">
                    <span class="px-6">Go <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">Bun <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">SQLite <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">TypeScript <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">ClickHouse <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">Cloudflare <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">Svelte 5 <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">Pebble KV <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">Litestream <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">Tailwind <span class="text-cyan-500 px-6">✦</span></span>
                    <span class="px-6">Postgres <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">Flutter <span class="text-cyan-500 px-6">✦</span></span><span class="px-6">Kotlin <span class="text-cyan-500 px-6">✦</span></span>
                </div>
            </div>

            <!-- ============ OFFER ============ -->
            <section id="offer" class="max-w-7xl mx-auto px-6 py-24 md:py-32">
                <div class="rv font-mono text-cyan-400 text-sm tracking-[.3em] uppercase mb-3">01 · What I offer</div>
                <h2 class="rv rv-d1 font-display font-bold text-gray-100 text-3xl md:text-5xl mb-4">Three ways we can<br />work <span class="bg-gradient-to-r from-cyan-300 to-emerald-400 bg-clip-text text-transparent">together.</span></h2>
                <p class="rv rv-d2 text-gray-500 mb-14 max-w-2xl">Fixed scope. Async by default. You talk to me, not an account manager.</p>
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-stretch">
                    <div class="rv spot bg-[#0F131A] border border-[#2A2F3A] rounded-3xl p-8 flex flex-col hover:border-cyan-500/40 transition-colors">
                        <div class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-3">2 weeks · fixed scope</div>
                        <h3 class="font-display font-bold text-2xl text-gray-100">Performance audit</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">I measure your stack on your servers, rank the bottlenecks, and fix the quick wins.</p>
                        <ul class="mt-5 space-y-2.5 font-mono text-sm text-gray-300 flex-1">
                            <li class="flex gap-3"><span class="text-cyan-400">▸</span>benchmark report you can rerun</li>
                            <li class="flex gap-3"><span class="text-cyan-400">▸</span>top 5 fixes by $ impact</li>
                            <li class="flex gap-3"><span class="text-cyan-400">▸</span>infra cost-cut plan</li>
                        </ul>
                        <div class="mt-5 font-mono text-xs text-gray-600">ex: 258K RPS on a $6 VPS, CDN bill cut in half</div>
                        <a href="mailto:maulana@drip.id?subject=Performance%20audit" class="mt-6 inline-flex items-center justify-center gap-2 border border-[#2A2F3A] text-gray-200 px-6 py-3 rounded-xl hover:border-cyan-500/60 hover:text-cyan-300 transition font-bold text-sm">Request audit <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
                    </div>
                    <div class="rv rv-d1 spot rounded-3xl p-8 flex flex-col border border-cyan-500/50 bg-gradient-to-b from-cyan-500/[.09] to-[#0F131A] relative">
                        <div class="absolute -top-3.5 left-8 font-mono text-[11px] font-bold tracking-[.2em] bg-cyan-400 text-[#0A0D12] rounded-full px-4 py-1">MOST HIRED</div>
                        <div class="font-mono text-xs text-cyan-400 uppercase tracking-widest mb-3">monthly · you own the code</div>
                        <h3 class="font-display font-bold text-2xl text-gray-100">Ship with me</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">MVP or full product, from schema to deploy. Demo every week, docs your team can run.</p>
                        <ul class="mt-5 space-y-2.5 font-mono text-sm text-gray-200 flex-1">
                            <li class="flex gap-3"><span class="text-cyan-400">▸</span>working demo every week</li>
                            <li class="flex gap-3"><span class="text-cyan-400">▸</span>Go / Bun backend, SQLite or tuned Postgres</li>
                            <li class="flex gap-3"><span class="text-cyan-400">▸</span>handoff docs your team can run</li>
                        </ul>
                        <div class="mt-5 font-mono text-xs text-gray-500">ex: 12K users, 2K paid subs, 72K visitors one live event</div>
                        <a href="mailto:maulana@drip.id?subject=Build%20with%20me" class="magnetic magnetic-btn mt-6 inline-flex items-center justify-center gap-2 bg-cyan-400 text-[#0A0D12] px-6 py-3 rounded-xl hover:bg-cyan-300 transition font-bold text-sm">Start your build <i data-lucide="rocket" class="w-4 h-4"></i></a>
                    </div>
                    <div class="rv rv-d2 spot bg-[#0F131A] border border-[#2A2F3A] rounded-3xl p-8 flex flex-col hover:border-cyan-500/40 transition-colors">
                        <div class="font-mono text-xs text-gray-600 uppercase tracking-widest mb-3">1–2 slots · advisory</div>
                        <h3 class="font-display font-bold text-2xl text-gray-100">Fractional CTO</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">Architecture reviews, hiring bar, and build-vs-buy calls with numbers attached.</p>
                        <ul class="mt-5 space-y-2.5 font-mono text-sm text-gray-300 flex-1">
                            <li class="flex gap-3"><span class="text-cyan-400">▸</span>weekly architecture review</li>
                            <li class="flex gap-3"><span class="text-cyan-400">▸</span>team leverage, not headcount</li>
                            <li class="flex gap-3"><span class="text-cyan-400">▸</span>build-vs-buy calls with numbers</li>
                        </ul>
                        <div class="mt-5 font-mono text-xs text-gray-600">selective · founders only</div>
                        <a href="mailto:maulana@drip.id?subject=Fractional%20CTO" class="mt-6 inline-flex items-center justify-center gap-2 border border-[#2A2F3A] text-gray-200 px-6 py-3 rounded-xl hover:border-cyan-500/60 hover:text-cyan-300 transition font-bold text-sm">Apply <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
                    </div>
                </div>
            </section>

            <!-- ============ PRODUCTION SYSTEMS ============ -->
            <section id="work" class="max-w-7xl mx-auto px-6 py-24 md:py-32">
                <div class="rv font-mono text-cyan-400 text-sm tracking-[.3em] uppercase mb-3">02 · Production systems</div>
                <h2 class="rv rv-d1 font-display font-bold text-gray-100 text-3xl md:text-5xl mb-4">Things I shipped<br /><span class="text-gray-600">that stayed up.</span></h2>
                <p class="rv rv-d2 text-gray-500 mb-14 max-w-2xl">I designed, built, and operated these. They handle real traffic today.</p>

                <!-- hero card: streaming -->
                <div class="rv spot border border-cyan-500/25 rounded-3xl p-8 md:p-12 mb-6 relative overflow-hidden bg-gradient-to-br from-[#0D1420] to-[#0A0D12]">
                    <div class="absolute -top-24 -right-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-[100px] pointer-events-none"></div>
                    <div class="flex flex-col lg:flex-row lg:items-end gap-8 justify-between relative">
                        <div class="max-w-2xl">
                            <div class="inline-flex items-center gap-2 font-mono text-xs text-emerald-400 border border-emerald-500/30 rounded-full px-3 py-1 mb-5">
                                <span class="live-dot w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span> in production
                            </div>
                            <h3 class="font-display font-bold text-2xl md:text-4xl text-gray-100">Live streaming without YouTube</h3>
                            <p class="mt-3 text-gray-400 leading-relaxed">One live event: 72K visitors, 126M requests in a day, 11TB served off the edge at 98% cache hit. Go HLS pipeline with adaptive renditions — zero buffering on 360/720.</p>
                        </div>
                        <div class="flex gap-8 md:gap-10 font-mono shrink-0">
                            <div><div class="font-display font-bold text-4xl md:text-5xl text-cyan-400"><span data-count="72">0</span>K</div><div class="text-gray-600 text-xs mt-1 uppercase tracking-widest">visitors, one event</div></div>
                            <div><div class="font-display font-bold text-4xl md:text-5xl text-gray-100"><span data-count="126">0</span>M</div><div class="text-gray-600 text-xs mt-1 uppercase tracking-widest">requests served</div></div>
                            <div><div class="font-display font-bold text-4xl md:text-5xl text-gray-100">98<span class="text-2xl text-gray-500">%</span></div><div class="text-gray-600 text-xs mt-1 uppercase tracking-widest">edge cache hit</div></div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="rv spot bg-[#0F131A] border border-[#2A2F3A] rounded-3xl p-8 hover:border-cyan-500/40 transition-colors">
                        <div class="font-mono text-xs text-gray-600 mb-3">saas · whatsapp automation</div>
                        <h3 class="font-display font-bold text-2xl text-gray-100">dripsender.id</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">WhatsApp marketing automation across 14 servers. Queue, workers, retries — 12,000+ users sending daily.</p>
                        <div class="mt-5 flex gap-6 font-mono text-sm"><div><span class="text-cyan-400 font-bold">12K+</span> <span class="text-gray-600 text-xs">users</span></div><div><span class="text-cyan-400 font-bold">14</span> <span class="text-gray-600 text-xs">servers</span></div></div>
                    </div>
                    <div class="rv rv-d1 spot bg-[#0F131A] border border-[#2A2F3A] rounded-3xl p-8 hover:border-cyan-500/40 transition-colors">
                        <div class="font-mono text-xs text-gray-600 mb-3">b2b · healthcare</div>
                        <h3 class="font-display font-bold text-2xl text-gray-100">Antre.in</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">Patient queue for clinics. Multi-tenant with RBAC and a websocket display for the waiting room.</p>
                        <div class="mt-5 flex gap-6 font-mono text-sm"><div><span class="text-cyan-400 font-bold">B2B</span> <span class="text-gray-600 text-xs">healthcare</span></div><div><span class="text-cyan-400 font-bold">realtime</span> <span class="text-gray-600 text-xs">queues</span></div></div>
                    </div>
                    <div class="rv spot bg-[#0F131A] border border-[#2A2F3A] rounded-3xl p-8 hover:border-cyan-500/40 transition-colors">
                        <div class="font-mono text-xs text-gray-600 mb-3">saas · billing</div>
                        <h3 class="font-display font-bold text-2xl text-gray-100">Orderlink.in</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">Subscription billing with 2,000+ paying subscribers. Money math is covered by tests.</p>
                        <div class="mt-5 flex gap-6 font-mono text-sm"><div><span class="text-cyan-400 font-bold">2K+</span> <span class="text-gray-600 text-xs">paid subs</span></div></div>
                    </div>
                    <div class="rv rv-d1 spot bg-[#0F131A] border border-[#2A2F3A] rounded-3xl p-8 hover:border-cyan-500/40 transition-colors">
                        <div class="font-mono text-xs text-gray-600 mb-3">saas · f&b</div>
                        <h3 class="font-display font-bold text-2xl text-gray-100">EatJom</h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">Multi-tenant restaurant OS — QR ordering, multi-kitchen receipts, per-brand theming. Dinner rush is the load test.</p>
                        <div class="mt-5 flex gap-6 font-mono text-sm"><div><span class="text-cyan-400 font-bold">SaaS</span> <span class="text-gray-600 text-xs">multi-tenant</span></div></div>
                    </div>
                    <a href="https://slugpost.com" class="rv spot group block bg-[#0F131A] border border-[#2A2F3A] rounded-3xl p-8 hover:border-cyan-500/50 transition-colors">
                        <div class="font-mono text-xs text-gray-600 mb-3">tool · live ↗</div>
                        <h3 class="font-display font-bold text-2xl text-gray-100 group-hover:text-cyan-400 transition">slug-post <i data-lucide="external-link" class="inline w-4 h-4 text-gray-600"></i></h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">Markdown to shareable web page. No registration, no friction. Live at slugpost.com.</p>
                        <div class="mt-5 flex gap-6 font-mono text-sm"><div><span class="text-cyan-400 font-bold">live</span> <span class="text-gray-600 text-xs">slugpost.com</span></div></div>
                    </a>
                    <a href="https://klikaja.app" class="rv rv-d1 spot group block bg-[#0F131A] border border-[#2A2F3A] rounded-3xl p-8 hover:border-cyan-500/50 transition-colors">
                        <div class="font-mono text-xs text-gray-600 mb-3">tool · live ↗</div>
                        <h3 class="font-display font-bold text-2xl text-gray-100 group-hover:text-cyan-400 transition">KlikAja <i data-lucide="external-link" class="inline w-4 h-4 text-gray-600"></i></h3>
                        <p class="mt-2 text-gray-400 text-sm leading-relaxed">Smart link shortener with analytics — QR codes, A/B testing, geo-routing.</p>
                        <div class="mt-5 flex gap-6 font-mono text-sm"><div><span class="text-cyan-400 font-bold">live</span> <span class="text-gray-600 text-xs">klikaja.app</span></div></div>
                    </a>
                </div>
            </section>

            <!-- ============ BENCHMARKS ============ -->
            <section class="border-y border-[#2A2F3A] bg-[#0C0F15]">
                <div class="max-w-7xl mx-auto px-6 py-20 md:py-24">
                    <div class="rv font-mono text-cyan-400 text-sm tracking-[.3em] uppercase mb-3">03 · Receipts</div>
                    <h2 class="rv rv-d1 font-display font-bold text-gray-100 text-3xl md:text-5xl mb-3">Opinions are cheap.<br /><span class="text-gray-600">Benchmarks aren't.</span></h2>
                    <p class="rv rv-d2 text-gray-500 mb-12 max-w-2xl">Measured on my own servers. Repro steps are in the repos.</p>
                    <div class="space-y-7 max-w-3xl" id="bench">
                        <div class="rv">
                            <div class="flex justify-between font-mono text-sm mb-2"><span class="text-gray-300">hook-sync <span class="text-gray-600">· batch writes via HTTP, 3.8x postgres</span></span><span class="text-cyan-400 font-bold">31K QPS</span></div>
                            <div class="h-3 rounded-full bg-[#1a1f29] overflow-hidden"><div class="bar h-full w-full rounded-full bg-gradient-to-r from-cyan-500 to-emerald-400"></div></div>
                        </div>
                        <div class="rv rv-d1">
                            <div class="flex justify-between font-mono text-sm mb-2"><span class="text-gray-300">laju <span class="text-gray-600">· ts web framework</span></span><span class="text-cyan-400 font-bold">258K RPS</span></div>
                            <div class="h-3 rounded-full bg-[#1a1f29] overflow-hidden"><div class="bar h-full w-[66%] rounded-full bg-gradient-to-r from-cyan-600 to-cyan-400"></div></div>
