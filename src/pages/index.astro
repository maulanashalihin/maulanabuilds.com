        <script>
            // ---------- reveal on scroll ----------
            const io = new IntersectionObserver((entries) => {
                entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
            }, { threshold: 0.12 });
            document.querySelectorAll('.rv').forEach((el) => io.observe(el));

            // ---------- animated counters ----------
            const counter = (el) => {
                const target = Number(el.dataset.count || '0');
                const t0 = performance.now(), dur = 1400;
                const tick = (now) => {
                    const p = Math.min(1, (now - t0) / dur);
                    const eased = 1 - Math.pow(1 - p, 3);
                    el.textContent = String(Math.round(target * eased));
                    if (p < 1) requestAnimationFrame(tick);
                };
                requestAnimationFrame(tick);
            };
            const cio = new IntersectionObserver((entries) => {
                entries.forEach((e) => { if (e.isIntersecting) { counter(e.target); cio.unobserve(e.target); } });
            }, { threshold: 0.6 });
            document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));

            // ---------- typing effect ----------
            const lines = [
                'go build ./... && shipped to 12,000 users',
                'bun ./bench.ts → 258,000 req/s on a $6 VPS',
                'sqlite reads local, ships via litestream',
            ];
            const typer = document.getElementById('typer');
            let li = 0, ci = 0, deleting = false;
            const type = () => {
                if (!typer) return;
                const line = lines[li];
                typer.textContent = line.slice(0, ci);
                if (!deleting && ci < line.length) { ci++; setTimeout(type, 42); }
                else if (!deleting) { deleting = true; setTimeout(type, 2100); }
                else if (ci > 0) { ci--; setTimeout(type, 18); }
                else { deleting = false; li = (li + 1) % lines.length; setTimeout(type, 350); }
            };
            type();

            // ---------- WIB clock ----------
            const clock = document.getElementById('clock');
            const tickClock = () => {
                if (!clock) return;
                try {
                    clock.textContent = new Intl.DateTimeFormat('en-GB', {
                        hour: '2-digit', minute: '2-digit', second: '2-digit',
                        timeZone: 'Asia/Jakarta', hour12: false,
                    }).format(new Date());
                } catch { clock.textContent = new Date().toLocaleTimeString(); }
            };
            tickClock(); setInterval(tickClock, 1000);


            // ---------- hero particle field ----------
            const cv = document.getElementById('field');
            if (cv && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
                const ctx = cv.getContext('2d');
                let pts = [];
                const size = () => {
                    const r = cv.parentElement.getBoundingClientRect();
                    cv.width = r.width; cv.height = r.height;
                    const n = Math.min(110, Math.floor((r.width * r.height) / 16000));
                    pts = Array.from({ length: n }, () => ({
                        x: Math.random() * cv.width, y: Math.random() * cv.height,
                        vx: (Math.random() - 0.5) * 0.35, vy: (Math.random() - 0.5) * 0.35,
                        r: Math.random() * 1.6 + 0.4,
                    }));
                };
                size(); addEventListener('resize', size);
                let mouse = { x: -9999, y: -9999 };
                cv.parentElement.addEventListener('mousemove', (e) => {
                    const r = cv.getBoundingClientRect();
                    mouse = { x: e.clientX - r.left, y: e.clientY - r.top };
                });
                cv.parentElement.addEventListener('mouseleave', () => { mouse = { x: -9999, y: -9999 }; });
                const draw = () => {
                    if (!ctx) return;
                    ctx.clearRect(0, 0, cv.width, cv.height);
                    pts.forEach((p) => {
                        p.x += p.vx; p.y += p.vy;
                        if (p.x < 0 || p.x > cv.width) p.vx *= -1;
                        if (p.y < 0 || p.y > cv.height) p.vy *= -1;
                        const dx = p.x - mouse.x, dy = p.y - mouse.y;
                        const d = Math.hypot(dx, dy);
                        if (d < 130 && d > 0.1) { p.x += (dx / d) * 0.7; p.y += (dy / d) * 0.7; }
                        ctx.globalAlpha = 0.55;
                        ctx.fillStyle = '#22d3ee';
                        ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 7); ctx.fill();
                    });
                    // links
                    ctx.globalAlpha = 1;
                    for (let i = 0; i < pts.length; i++) {
                        for (let j = i + 1; j < pts.length; j++) {
                            const a = pts[i], b = pts[j];
                            const d = Math.hypot(a.x - b.x, a.y - b.y);
                            if (d < 120) {
                                ctx.strokeStyle = `rgba(34,211,238,${(1 - d / 120) * 0.14})`;
                                ctx.lineWidth = 1;
                                ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
                            }
                        }
                    }
                    requestAnimationFrame(draw);
                };
                draw();
            }

            // ---------- marquee duplicate (safe clone) ----------
            const mq = document.getElementById('mq');
            if (mq) Array.from(mq.children).forEach((el) => mq.appendChild(el.cloneNode(true)));

            // ---------- spotlight cards ----------
            document.querySelectorAll('.spot').forEach((c) => {
                c.addEventListener('mousemove', (e) => {
                    const r = c.getBoundingClientRect();
                    c.style.setProperty('--mx', (e.clientX - r.left) + 'px');
                    c.style.setProperty('--my', (e.clientY - r.top) + 'px');
                });
            });

            // ---------- magnetic buttons ----------
            if (matchMedia('(hover: hover)').matches) {
                document.querySelectorAll('.magnetic-btn').forEach((el) => {
                    el.addEventListener('mousemove', (e) => {
                        const r = el.getBoundingClientRect();
                        const x = e.clientX - r.left - r.width / 2;
                        const y = e.clientY - r.top - r.height / 2;
                        el.style.transform = `translate(${x * 0.14}px, ${y * 0.2}px)`;
                    });
                    el.addEventListener('mouseleave', () => { el.style.transform = ''; });
                });
            }
        </script>
    </LucideIcons>
</Layout>
