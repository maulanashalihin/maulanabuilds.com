---
// Header Component - Navigation with anchor links
---

<header
    class="fixed top-0 left-0 right-0 z-50 bg-[#0A0D12]/80 backdrop-blur-md border-b border-[#2A2F3A]"
>
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between h-16">
            <!-- Logo -->
            <a
                href="/"
                class="text-gray-100 font-mono text-sm font-bold tracking-tight hover:text-cyan-400 transition"
            >
                Maulana Builds
            </a>

            <!-- Navigation -->
            <nav class="hidden md:flex items-center gap-8">
                <a
                    href="/#work"
                    class="text-sm text-gray-400 hover:text-cyan-400 transition"
                    >Work</a
                >
                <a
                    href="/#opensource"
                    class="text-sm text-gray-400 hover:text-cyan-400 transition"
                    >Open Source</a
                >
                <a
                    href="/#engineering"
                    class="text-sm text-gray-400 hover:text-cyan-400 transition"
                    >Engineering</a
                >
                <a
                    href="/#about"
                    class="text-sm text-gray-400 hover:text-cyan-400 transition"
                    >About</a
                >
                <a
                    href="/#contact"
                    class="text-sm text-gray-400 hover:text-cyan-400 transition"
                    >Contact</a
                >
            </nav>

            <!-- Mobile Menu Button -->
            <button
                id="mobile-menu-btn"
                class="md:hidden text-gray-400 hover:text-cyan-400 transition"
                aria-label="Toggle menu"
            >
                <i data-lucide="menu" class="w-6 h-6"></i>
            </button>
        </div>
    </div>

    <!-- Mobile Menu -->
    <div
        id="mobile-menu"
        class="hidden md:hidden border-t border-[#2A2F3A] bg-[#0A0D12]"
    >
        <nav class="flex flex-col px-6 py-4 space-y-4">
            <a
                href="/#work"
                class="text-sm text-gray-400 hover:text-cyan-400 transition"
                >Work</a
            >
            <a
                href="/#opensource"
                class="text-sm text-gray-400 hover:text-cyan-400 transition"
                >Open Source</a
            >
            <a
                href="/#engineering"
                class="text-sm text-gray-400 hover:text-cyan-400 transition"
                >Engineering</a
            >
            <a
                href="/#about"
                class="text-sm text-gray-400 hover:text-cyan-400 transition"
                >About</a
            >
            <a
                href="/#contact"
                class="text-sm text-gray-400 hover:text-cyan-400 transition"
                >Contact</a
            >
        </nav>
    </div>
</header>

<script>
    // Mobile menu toggle
    const menuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    menuBtn?.addEventListener("click", () => {
        mobileMenu?.classList.toggle("hidden");
    });

    // Close mobile menu when clicking a link
    mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
        });
    });
</script>
